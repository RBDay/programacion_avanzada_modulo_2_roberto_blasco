# Configuración de Base de Datos MySQL
MYSQL_ROOT_PASSWORD=root_password
DB_NAME=notes_db
DB_USER=notes_user
DB_PASSWORD=notes_password
DB_HOST=mysql
DB_PORT=3306

# Puertos expuestos en el Host
# (Se usan 8001, 8081 y 3308 para evitar conflictos con otros servicios locales)
API_PORT=8001
PHPMYADMIN_PORT=8081
MYSQL_PORT=3308

# URL del API para pruebas automatizadas
API_URL=http://api:8000
